server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DICOM previews and uploads pass through here.
    client_max_body_size 100m;

    # Path-traversal guard. /api/bucket/* (server/handler/bucket.js)
    # path.join's the request path onto BUCKET_PATH with no containment check,
    # so `/api/bucket/../..` lists directories outside the bucket. Defence in
    # depth until that handler is fixed: nothing with `..` — raw or
    # percent-encoded — reaches the api. $request_uri is the undecoded
    # original, args included. (/api/waveform confines paths itself.)
    if ($request_uri ~* "(\.\.|%2e%2e|%2e\.|\.%2e)") {
        return 400;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /docs {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    # Hashed build assets never change under the same name.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback — client routes like /ive/table/dicom have no file on disk.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
