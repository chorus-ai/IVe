# Copy to .env next to docker-compose.yml. Passed whole to the api container.
# Services on the Docker host itself are reachable as host.docker.internal.

# --- required ---
# openssl rand -hex 32
JWT_SECRET=
APP_NAME=IVe
# Client name shown on sign-in/sign-up and in tab titles. Baked in at build
# time: `docker compose up -d --build` after changing.
VITE_APP_NAME=IVe
APP_HOST=https://ive.example.org
WEB_PORT=8080
# The image runs NODE_ENV=production, so auth cookies are Secure: serve over
# HTTPS (TLS terminated in front of `web`) or browse via http://localhost.

# --- databases ---
# SQLite (default): files in ./server/data on the host (mounted at
# /srv/server/data), created on first boot if absent. To use existing data,
# put the file there before `docker compose up`.
APP_DB_DIALECT=sqlite
APP_DB_STORAGE=/srv/server/data/app.sqlite3

# OMOP gets its own instance. Add vocab here (plus VOCAB_DB_*) if the concept
# table lives elsewhere; otherwise it sits in the app DB.
FEATURE_HAS_DEDICATED_DB=omop
OMOP_DB_DIALECT=sqlite
OMOP_DB_STORAGE=/srv/server/data/omop.sqlite3

# Postgres instead: replace a block above with the following (same for OMOP_).
# Connections ALWAYS use SSL (server/config/env.js), and the schema must
# already exist — sync() creates tables, never schemas.
#   APP_DB_DIALECT=postgres
#   APP_DB_HOSTNAME=host.docker.internal   # or a remote host
#   APP_DB_PORT=5432
#   APP_DB_USERNAME=
#   APP_DB_PASSWORD=
#   APP_DB_NAME=
#   APP_DB_SCHEMA=public

# --- Redis (cache only — no jobs in this build) ---
# host.docker.internal = the machine Docker runs on.
# Host/port only: no password or TLS support. Unreachable = caching disabled,
# the app keeps working.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# --- Orthanc (DICOM) ---
# Server-side only; Orthanc serves full PHI and must not be browser-reachable.
# Blank username = no Authorization header.
ORTHANC_URL=http://host.docker.internal:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
ORTHANC_TIMEOUT_MS=30000

# --- optional ---
# ai-service for /api/dicom/instances/:id/phi-scan; unset = that endpoint 503s.
AI_SERVICE_URL=
INTERNAL_SERVICE_TOKEN=

# ---- Storage ----
# BUCKET_PATH: host folder holding the bucket (waveforms etc.) AND the SQLite
# files above, mounted read-write at /srv/server/data — the *_DB_STORAGE paths
# point inside it. Unset = ./server/data. Records are addressed relative to
# it, e.g. waveforms/mimic_iv/p100/... .
# Logged-in users can list file names in it (/api/bucket) and decode WFDB
# records from it (/api/waveform); no endpoint in this build serves other
# files' contents.
# BUCKET_NAME: S3 bucket for /api/bucket/s3/* (needs the AWS_* vars).
BUCKET_PATH=./server/data
BUCKET_NAME=

# OAuth — leave blank to disable. GITHUB_CLIENT_ID is also baked into the
# client's "Sign in with GitHub" link: rebuild (`--build`) after changing it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
