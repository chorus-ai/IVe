{
  "tags": [
    {
      "name": "iveEndpoint",
      "description": "Saved OMOP API endpoints"
    },
    {
      "name": "iveLayout",
      "description": "Dashboard layout management"
    },
    {
      "name": "iveWidget",
      "description": "Widget template management"
    },
    {
      "name": "iveTag",
      "description": "Tagging for IVE layouts, widgets and endpoints"
    }
  ],
  "components": {
    "schemas": {
      "iveEndpointBody": {
        "type": "object",
        "required": [
          "endpoint"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "example": "/condition_occurrence/search"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE"
            ],
            "default": "POST"
          },
          "params": {
            "type": "object",
            "properties": {
              "body": {
                "type": "object"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "countOnly": {
                "type": "boolean"
              }
            }
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tag slugs to attach on create/update; synced to the iveTag join table. Returned tags are in the readonly iveTags array."
          },
          "isPublic": {
            "type": "boolean",
            "default": true,
            "description": "When true, any authenticated user can read this saved endpoint"
          },
          "isCached": {
            "type": "boolean",
            "default": false,
            "description": "When true, server may serve this endpoint's response from cache"
          }
        }
      },
      "iveEndpoint": {
        "allOf": [
          {
            "$ref": "#/components/schemas/iveEndpointBody"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "readOnly": true
              },
              "userId": {
                "type": "integer",
                "readOnly": true,
                "description": "Owner (createdBy)"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true
              },
              "iveTags": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IveTag"
                },
                "readOnly": true
              },
              "createdBy": {
                "type": "object",
                "readOnly": true,
                "nullable": true
              }
            }
          }
        ]
      },
      "iveLayoutBody": {
        "type": "object",
        "required": [
          "name",
          "config"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "My Dashboard"
          },
          "config": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": [
              {
                "id": "w1",
                "type": "stats",
                "title": "KPIs",
                "w": 12
              }
            ]
          }
        }
      },
      "iveLayout": {
        "allOf": [
          {
            "$ref": "#/components/schemas/iveLayoutBody"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "readOnly": true
              },
              "userId": {
                "type": "integer",
                "readOnly": true,
                "description": "Owner (createdBy)"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true
              },
              "iveTags": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IveTag"
                },
                "readOnly": true
              },
              "createdBy": {
                "type": "object",
                "readOnly": true,
                "nullable": true
              }
            }
          }
        ]
      },
      "iveWidgetBody": {
        "type": "object",
        "required": [
          "name",
          "type",
          "config"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "config": {
            "type": "object"
          }
        }
      },
      "iveWidget": {
        "allOf": [
          {
            "$ref": "#/components/schemas/iveWidgetBody"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "readOnly": true
              },
              "userId": {
                "type": "integer",
                "readOnly": true,
                "description": "Owner (createdBy)"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true
              },
              "iveTags": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IveTag"
                },
                "readOnly": true
              },
              "createdBy": {
                "type": "object",
                "readOnly": true,
                "nullable": true
              }
            }
          }
        ]
      },
      "IveTag": {
        "type": "object",
        "required": [
          "slug"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "example": "admin-panel"
          }
        }
      },
      "IveSlugList": {
        "type": "object",
        "required": [
          "slugs"
        ],
        "properties": {
          "slugs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "example": [
              "admin-panel",
              "patient-summary"
            ]
          }
        }
      },
      "IveTagResources": {
        "type": "object",
        "properties": {
          "tag": {
            "$ref": "#/components/schemas/IveTag"
          },
          "layouts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "widgets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "requestBodies": {
      "iveEndpoint": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/iveEndpointBody"
            }
          }
        }
      },
      "iveEndpointUpdate": {
        "required": false,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/iveEndpointBody"
            }
          }
        }
      },
      "iveLayout": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/iveLayoutBody"
            }
          }
        }
      },
      "iveLayoutUpdate": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/iveLayoutBody"
            }
          }
        }
      },
      "iveWidget": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/iveWidgetBody"
            }
          }
        }
      },
      "iveWidgetUpdate": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/iveWidgetBody"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/ive/endpoint": {
      "get": {
        "tags": [
          "iveEndpoint"
        ],
        "operationId": "listEndpointsByTagSlug",
        "summary": "List saved endpoints by tag slug (via the iveTag join table). Required: ?tag=:slug",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "tag",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Tag slug"
          }
        ],
        "responses": {
          "200": {
            "description": "Endpoints carrying the tag"
          },
          "400": {
            "description": "Missing required query param: tag"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "iveEndpoint"
        ],
        "operationId": "createEndpoint",
        "summary": "Save a new endpoint",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/iveEndpoint"
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "endpoint is required"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/ive/endpoint/users/{uid}": {
      "get": {
        "tags": [
          "iveEndpoint"
        ],
        "operationId": "listEndpointsByUser",
        "summary": "List saved endpoints by user",
        "security": [
          {
            "bearerAuth": []
          }
