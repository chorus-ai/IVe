                    "type": "string"
                  },
                  "page": {
                    "type": "integer",
                    "default": 1
                  },
                  "pageSize": {
                    "type": "integer",
                    "default": 10
                  },
                  "sortOrder": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc"
                    ],
                    "default": "desc"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Results"
          },
          "404": {
            "description": "No match"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
