          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/ive/endpoint/tags/{tagName}": {
      "get": {
        "tags": [
          "iveEndpoint"
        ],
        "operationId": "listEndpointsByLegacyTag",
        "summary": "List saved endpoints by tag slug via the iveTag join table (back-compat path)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "tagName",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
