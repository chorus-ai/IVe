          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "tagId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated endpoint with tags"
          }
        }
      }
    },
    "/ive/layout": {
      "get": {
        "tags": [
          "iveLayout"
        ],
        "operationId": "listLayouts",
        "summary": "List all layouts (or filter by ?tag=:slug)",
        "security": [
          {
