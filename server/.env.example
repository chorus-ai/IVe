# ---- Runtime ----
NODE_ENV=development
PORT=8080
APP_HOST=
APP_NAME=
APP_VERSION=1.0.0

# ---- Auth ----
JWT_SECRET=change-me

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=

# ---- Feature toggle ----
# Comma-separated allowlist. Unset/empty = ALL features load.
# Available: omop,vocab,form,assets,cada,ive,m2d,cbw,crc,diet,pair,post,survey,alarmx
FEATURES=

# FEATURE_HAS_DEDICATED_DB: comma-separated list of features that bind to their
# own DB (prefix = uppercased feature name, e.g. omop -> OMOP_DB_*) instead of
# the app DB. A listed feature's DB is built ONLY when it's also in FEATURES.
# Deploying without `omop` needs neither entry.
FEATURE_HAS_DEDICATED_DB=omop

# ---- Databases (per-DB, fully env-driven) ----
# Two logical DBs, configured independently:
#   APP  — everything writable (users, features)
#   OMOP — the read-only clinical data source as its own dedicated database
#
#   <PREFIX>_DB_DIALECT   sqlite | postgres        (default: sqlite)
#   SQLite:   <PREFIX>_DB_STORAGE   path           (required)
#   Postgres: <PREFIX>_DB_HOSTNAME / _PORT / _USERNAME / _PASSWORD / _NAME / _SCHEMA
#             each postgres DB must specify its own full connection.
#             _SCHEMA is deployment-specific and REQUIRED for postgres
#
APP_DB_DIALECT=sqlite
APP_DB_STORAGE=data/db.sqlite3      # sqlite only; path to the app DB file


# Only needed when `omop` is in both FEATURES and FEATURE_HAS_DEDICATED_DB:
OMOP_DB_DIALECT=postgres
# OMOP_DB_STORAGE=data/omop.sqlite3  # when OMOP_DB_DIALECT=sqlite
OMOP_DB_HOSTNAME=... 
OMOP_DB_USERNAME=... 
OMOP_DB_PASSWORD=... 
OMOP_DB_NAME=... 
OMOP_DB_SCHEMA=...



# ---- Storage ----
BUCKET_PATH=
BUCKET_NAME=

# ---- AWS S3 ----
# Convention: if AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are missing or empty,
# we assume we're on a production VM and the SDK pulls creds from the instance
# role (EC2/ECS IMDS). Only fill these in for LOCAL dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# ---- Misc ----
PYTHON_PATH=
